{
  "expo": {
    "name": "ConstitutAImain",
    "slug": "ConstitutAImain",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "bundleIdentifier": "com.georgetteesinam.constitutai",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.georgetteesinam.constitutai",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "output": "single",
      "name": "ConstitutAI",
      "shortName": "ConstitutAI",
      "description": "A constitutional legal assistant for Ghana.",
      "favicon": "./assets/icon.png",
      "themeColor": "#0f1f3d",
      "backgroundColor": "#e8eaed",
      "display": "standalone",
      "startUrl": "/",
      "orientation": "portrait"
    },
    "plugins": [
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "345d5ed9-9193-409a-ad90-b813474809d2"
      }
    }
  }
}
