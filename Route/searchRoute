// routes/searchRoutes.js
// Purpose: Handles search queries across articles (and optionally other
// content types), including keyword search and filtered/advanced search.

const express = require('express');
const router = express.Router();
const searchController = require('../controllers/searchController');

// Basic keyword search (e.g. /search?q=climate+change)
router.get('/', searchController.search);

// Advanced search with filters (category, date range, author, etc.)
router.get('/advanced', searchController.advancedSearch);

// Autocomplete/suggested search terms as the user types
router.get('/suggestions', searchController.getSuggestions);

module.exports = router;